{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/checador",
        "destination": "/checador-movil.html"
      },
      {
        "source": "/checador-movil",
        "destination": "/checador-movil.html"
      },
      {
        "source": "/cdi",
        "destination": "/cdi-movil.html"
      },
      {
        "source": "/cdi-movil",
        "destination": "/cdi-movil.html"
      },
      {
        "source": "/recorridos",
        "destination": "/recorrido-movil.html"
      },
      {
        "source": "/bitacora",
        "destination": "/bitacora-movil.html"
      },
      {
        "source": "/mec",
        "destination": "/mec-movil.html"
      },
      {
        "source": "/mec-movil",
        "destination": "/mec-movil.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
